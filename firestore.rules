rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Legacy user doc — frozen, read once during migration
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    /* config/igdb was here: a world-readable document holding the IGDB
     * credential, from before functions/proxy.js existed. Nothing has read it
     * since the proxy took over the credential, so the rule was exposing a
     * superseded pair to anyone who looked -- including, once this repository
     * went public, anyone reading this file. Removed rather than tightened,
     * because the right number of rules for a document nothing reads is zero.
     * The document itself is deleted separately; see SECURITY.md.
     */

    match /config/app {
      allow read: if true;
      allow write: if false;
    }

    // Schema v2 — note the data block is NESTED inside this one
    match /lorehaven_users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      /* Split by operation on purpose.
       *
       * A delete carries no request.resource, so folding it into the same
       * clause as create/update would reject every shard cleanup that
       * dropShardsFrom performs and strand orphaned shards behind a library
       * that had shrunk.
       *
       * compatLevel is the compatibility gate. A build below the minimum
       * resurrects deleted games, never stamps its edits, and overwrites the
       * whole library document -- see docs/superpowers/specs for what that
       * cost. The client refuses to write when it knows it is too old; this is
       * the half that works on builds that can no longer be changed. */
      match /data/{docId} {
        allow read:   if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
                              && request.resource.data.compatLevel is int
                              && request.resource.data.compatLevel >= 2;
      }
    }

    // One-time migration backups
    match /backups/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // --- Global Wikidata Awards Cache ---
    //
    // THIS is the collection the client uses. src/services/wikidata/awards.js
    // sets AWARDS_COLLECTION = 'award_cache' and is the only reader or writer in
    // the app. It holds one document per cache key -- a game id, the ceremonies
    // index, or a single ceremony -- each shaped exactly { awards, updatedAt }.
    //
    // Readable by everyone including signed-out visitors: the whole point of the
    // tier is that one person's Wikidata query serves the next visitor, and most
    // people browsing /awards are not signed in. The payload is public Wikidata
    // content, so there is nothing here to leak.
    //
    // Writes stay open for the same reason -- gating them on auth would leave the
    // cache cold for most of the people it exists for -- but they are constrained
    // three ways rather than blanket:
    //
    //   - only the two fields the client writes,
    //   - a server-set timestamp, so a client cannot forge freshness and pin
    //     stale data for the full 30-day TTL,
    //   - and only the document ids the app actually writes. Without the last
    //     one an anonymous client could create unbounded documents under names
    //     nothing will ever read, which is a billing and storage problem rather
    //     than a data one, but it is one nobody would notice.
    //
    // The three id shapes are awards.js's own: `ceremonies` (fetchCeremonies),
    // `ceremony4_<QID>` (fetchCeremony), and the bare IGDB id (fetchGameAwards,
    // which overrides docId so documents written by the previous implementation
    // keep resolving). Adding a fourth cache key means adding it here too.
    //
    // Deletes are refused -- nothing in the app deletes, and a missing entry
    // costs every visitor a slow cold query.
    match /award_cache/{docId} {
      allow read: if true;
      allow create, update: if docId.matches('ceremonies|ceremony4_Q[0-9]+|[0-9]+')
                            && request.resource.data.keys().hasOnly(['awards', 'updatedAt'])
                            && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    /* `gameAwards`, `awardWins` and `awardsCatalog` were `allow read, write: if
     * true` -- world-writable, unauthenticated, unconstrained -- and nothing in
     * src/ has ever referenced any of them. They are removed rather than kept
     * "in case", because an open write surface nobody reads is one nobody
     * watches either. Removing the match denies every operation by default; it
     * does not delete data, so anything already in them is still there to
     * inspect with an admin credential before it is dropped.
     */
  }
}
