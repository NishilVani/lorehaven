# Secrets — never commit
*.keystore
*.jks
keystore.properties
datbase_config.json
google-services.json
*-service-account*.json

# Env files. .env.production and .env.development are tracked on purpose: both
# hold only the public proxy hostname, which is not a secret. Anything else may
# hold a credential, so it stays out.
.env
.env.*
!.env.production
!.env.development

# Overnight QA run artifacts (STATUS.md carries the summary)
qa/

# Subagent-driven-development scratch: ledgers, briefs, review packages.
.superpowers/

# Agent-harness tooling. These are per-machine copies of the same skill set for
# different harnesses (Antigravity, Codex, Copilot, Impeccable). They are kept on
# disk because the local tooling reads them, but they are not project source and
# tracking three near-identical copies bloats the repo. The design-system
# reference that CLAUDE.md's file map points at — tokens/, components/,
# accessibility/, workflows/, taste/, content/, frameworks/, design-systems/ —
# stays tracked.
.agents/
.codex/
.impeccable/
Fable5.md
.github/skills/
.github/agents/
.github/hooks/
.github/copilot-instructions.md

# Screenshots and scratch capture
MoctaleSS/
