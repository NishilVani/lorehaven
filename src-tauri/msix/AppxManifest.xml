<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for the Microsoft Store listing (Store ID 9N7FD5QBSMBB).

  The three Identity values are assigned by Partner Center, not chosen by us, and
  the package is rejected if any differs by a character. They are hardcoded here
  rather than injected from CI because they are fixed for the life of the app and
  are not secret — every published package carries them, and the listing URL
  (https://apps.microsoft.com/detail/9N7FD5QBSMBB) is public. They came from
  Product management -> Product identity.

  Note the spelling: the publisher is "LoreHeaven", the app is "LoreHaven". That
  is what Partner Center has, so that is what has to be here.

  {{VERSION}} is the only substitution, done by scripts/pack_msix.ps1. It is
  four-part: the Store reserves the fourth field and requires 0 in what you
  upload, so 1.2.3 is packed as 1.2.3.0.

  The app is a normal Win32 executable, not a UWP app, which is what
  EntryPoint="Windows.FullTrustApplication" plus the runFullTrust capability
  declare. Without both, the package builds and then fails certification.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="LoreHeaven.LoreHaven"
    Publisher="CN=CEEF9C0A-EDC7-4AE4-9AC3-FA2F4AC45FD8"
    Version="{{VERSION}}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>LoreHaven</DisplayName>
    <PublisherDisplayName>LoreHeaven</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- 10.0.17763.0 is the first build with full MSIX desktop support. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="LoreHaven" Executable="LoreHaven.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="LoreHaven"
        Description="A personal game library: track what you own across every platform."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <!-- Only the logos Tauri actually generates are referenced. A manifest
             that names an asset the package does not contain fails to build, and
             the wide tile and splash screen are both optional for a full-trust
             desktop app: the splash is never shown for one at all. -->
        <uap:DefaultTile
          Square310x310Logo="Assets\Square310x310Logo.png"
          Square71x71Logo="Assets\Square71x71Logo.png"
          ShortName="LoreHaven" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- A packaged Win32 app is a restricted capability. The Store grants it. -->
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
